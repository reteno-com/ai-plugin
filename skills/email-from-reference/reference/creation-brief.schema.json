{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/reteno-com/ai-plugin/blob/main/skills/email-from-reference/reference/creation-brief.schema.json",
  "title": "Native email creation brief",
  "description": "Message metadata and a native editor model draft. The completed model is validated against the schema supplied by Reteno.",
  "type": "object",
  "required": [
    "v",
    "message",
    "model"
  ],
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 2
    },
    "note": {
      "type": "string"
    },
    "sourceSummary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "message": {
      "type": "object",
      "required": [
        "subject"
      ],
      "additionalProperties": true,
      "properties": {
        "referenceMode": {
          "type": "string",
          "enum": [
            "exact",
            "tailored",
            "creative",
            "copy-action"
          ],
          "default": "creative",
          "description": "Local generation policy; do not send to MCP. copy-action is a legacy alias for tailored."
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "interfaceId": {
          "type": [
            "string",
            "integer"
          ]
        },
        "sender": {
          "type": "object"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "model": {
      "type": "object",
      "description": "Native editor model draft, including resources.fonts and fontFamily settings. The bundled editor contract validates the completed model."
    }
  }
}
